# Copy to .env and adjust. Never commit .env.

ENVIRONMENT=development

# PostgreSQL with PostGIS (matches infra/docker-compose.dev.yml)
POSTGRES_USER=zira
POSTGRES_PASSWORD=zira
POSTGRES_DB=zira
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://zira:zira@localhost:5432/zira

# Redis (job queue)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend
# Signs access tokens. In production it must be a random value of at least 32
# characters, for example the output of: openssl rand -hex 32
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=720
POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Backend tests that need PostgreSQL (created by infra/postgres/init on a new volume)
TEST_DATABASE_URL=postgresql+psycopg://zira:zira@localhost:5432/zira_test

# Frontend (server side only; never sent to the browser)
BACKEND_URL=http://localhost:8000

# Google Earth Engine (Phase 5: Field Memory). Leave empty until then.
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_PATH=
