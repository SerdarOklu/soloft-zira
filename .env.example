# Copy to .env and adjust. Never commit .env.

ENVIRONMENT=development

# PostgreSQL with PostGIS (matches infra/docker-compose.dev.yml)
POSTGRES_USER=zira
POSTGRES_PASSWORD=zira
POSTGRES_DB=zira
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://zira:zira@localhost:5432/zira

# Redis (job queue)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend
SECRET_KEY=change-me
POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Google Earth Engine (Phase 5: Field Memory). Leave empty until then.
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_PATH=
