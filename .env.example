# Copy to .env and adjust. Never commit .env.

ENVIRONMENT=development

# PostgreSQL with PostGIS (matches infra/docker-compose.dev.yml)
POSTGRES_USER=zira
POSTGRES_PASSWORD=zira
POSTGRES_DB=zira
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://zira:zira@localhost:5432/zira

# Redis (job queue)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend
# Signs access tokens. In production it must be a random value of at least 32
# characters, for example the output of: openssl rand -hex 32
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=720
POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Backend tests that need PostgreSQL (created by infra/postgres/init on a new volume)
TEST_DATABASE_URL=postgresql+psycopg://zira:zira@localhost:5432/zira_test

# Frontend (server side only; never sent to the browser)
BACKEND_URL=http://localhost:8000

# Google Earth Engine (Phase 5: Field Memory). Leave empty until then.
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_PATH=

# WhatsApp through Green API (https://green-api.com, free developer plan). Create an instance,
# scan its QR code with the sending phone, then paste the instance id and API token here.
# Empty values are fine: approved messages then wait and nothing is sent.
GREEN_API_URL=https://api.green-api.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# Sensors (phase 7). The shared key a node or the simulator sends in the X-Sensor-Key header.
# Empty turns sensor ingest off. Generate one with: openssl rand -hex 24
SENSOR_INGEST_KEY=

# Demo sign-in: choose a role and enter with no password (needs `python -m app.cli seed-demo`).
# Only for a jury demo; leave false for real users.
DEMO_ROLE_LOGIN=false

# NASA Earthdata user token (https://urs.earthdata.nasa.gov, Profile, Generate Token). It reads SMAP,
# GPM IMERG and GRACE. Empty keeps them unconnected. It expires, so renew it.
EARTHDATA_TOKEN=

# Optional Google satellite basemap (Map Tiles API). The default satellite map (Esri) needs no key.
# The key reaches the browser, so restrict it to your site's address in Google Cloud.
GOOGLE_MAPS_API_KEY=
