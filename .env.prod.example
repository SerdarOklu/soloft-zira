# Production environment for infra/docker-compose.prod.yml. Copy to .env on the VPS and
# fill in real values. NEVER commit the real .env (.gitignore already excludes it).

# The domain whose DNS A/AAAA record points at this VPS. Used by Nginx and the certificate.
ZIRA_DOMAIN=zira.example.com
# Email for Let's Encrypt expiry notices (used by infra/scripts/init-letsencrypt.sh).
CERTBOT_EMAIL=ops@example.com

# PostgreSQL. Choose a strong password; it is never exposed outside the Compose network.
POSTGRES_USER=zira
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=zira

# Signs access tokens. MUST be a random value of at least 32 characters, e.g.
#   openssl rand -hex 32
# Production refuses to start with the placeholder or a short value.
SECRET_KEY=change-me-openssl-rand-hex-32
ACCESS_TOKEN_TTL_MINUTES=720
POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Which image build to run. Default is :latest (the newest push to main). Pin to a
# specific build for a reproducible deploy, e.g. IMAGE_TAG=sha-abc1234.
IMAGE_TAG=latest

# Optional: copy the daily database dump off-server (infra/scripts/backup.sh).
# scp style:     [email protected]:/backups/zira
# rclone style:  rclone:myremote:zira-backups
# BACKUP_REMOTE=

# WhatsApp through Green API (free developer plan). Instance id and token from the Green API
# console after scanning the QR code with the sending phone. Leave empty to keep sending off.
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
